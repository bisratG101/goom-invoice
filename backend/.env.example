# Environment & Server Config
NODE_ENV=development
PORT=4000

# Development Database (Used by 'npm run dev' — persistent development & manual QA data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/goom_dev

# Automated Test Database (Used by 'npm test' — tables are wiped/truncated during test runs)
# WARNING: Must contain an explicit 'test' identifier and MUST NOT point to goom_dev or production.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/goom_test

# Authentication & Security
JWT_SECRET=your_minimum_32_character_random_jwt_secret_here
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Payment Gateways & Simulation
PAYMENT_PROVIDERS=chapa,simulated
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
DEMO_MODE=true
SIMULATED_WEBHOOK_SECRET=
LLM_API_KEY=
LLM_MONTHLY_LIMIT=50
